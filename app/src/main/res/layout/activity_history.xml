<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="#FFF5EF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Mood Journal 📖"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#49374E"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Every feeling tells a story."
        android:textSize="15sp"
        android:textColor="#897783"
        android:layout_marginBottom="16dp"/>

    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E8DCEB"
        android:dividerHeight="10dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"/>

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Back to My Moods"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#8B78C6"/>

</LinearLayout>
