<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5EF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How are you feeling? 🌼"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#49374E"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="There is no right or wrong feeling."
            android:textColor="#897783"
            android:textSize="15sp"
            android:layout_marginBottom="22dp"/>

        <Button
            android:id="@+id/happy"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="😊   Happy"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="#F4D7A8"
            android:textColor="#49374E"/>

        <Button
            android:id="@+id/calm"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:text="😌   Calm"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="#CDE8D5"
            android:textColor="#344D40"/>

        <Button
            android:id="@+id/loved"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:text="🥰   Loved"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="#F5D2E0"
            android:textColor="#634052"/>

        <Button
            android:id="@+id/sad"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:text="😢   Sad"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="#D8E5F9"
            android:textColor="#344760"/>

        <Button
            android:id="@+id/anxious"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:text="😰   Anxious"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="#E5D8F6"
            android:textColor="#49374E"/>

        <Button
            android:id="@+id/angry"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:text="😠   Angry"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="#F5C9C1"
            android:textColor="#63413C"/>

        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:text="View My Mood History"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B78C6"/>

    </LinearLayout>
</ScrollView>
